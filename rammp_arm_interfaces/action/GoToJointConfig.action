# Goal — move to a 7-joint configuration; cuRobo plans collision-free (plan_to_joints).
float64[7] target_joints   # rad, joint_1..joint_7
string     sender_id       # arbitration hook, mirrors ExecuteJointTrajectory
uint8[16] token                    # arbitration capability from /acquire_control
# Execute this move slower: 1.0 = as planned. Out of range is refused, not
# clamped -- a value below the floor would otherwise be silently sped up to it.
# The lower bound is the executing driver's minimum scale, currently 0.01; zero
# is not permitted because it would stop the trajectory clock and the goal
# would never complete.
float64 speed_scale 1.0
# No orientation_hold here on purpose: planning is in joint space,
# where holding a tool orientation has no meaning.
# How the planned trajectory is EXECUTED. Planning is unchanged -- cuRobo plans
# collision-free exactly as before; IMPEDANCE executes the plan compliantly.
uint8 CONTROL_MODE_POSITION=0
uint8 CONTROL_MODE_IMPEDANCE=1
uint8 control_mode 0
# Compliance iff IMPEDANCE; the default (PROFILE_SESSION_DEFAULT) means "run
# under the session default". A non-default spec on a POSITION goal is refused,
# not ignored.
GainsSpec gains
---
# Result
int32   error_code   # SUCCESSFUL=0, INVALID_GOAL=-1, PATH_TOLERANCE_VIOLATED=-4,
                     # PREEMPTED=-6, PLANNING_FAILED=-7,
                     # NOT_AUTHORIZED=-8, HALTED=-9
string  error_string
trajectory_msgs/JointTrajectoryPoint final_error   # joint-space final error
---
# Feedback
string  phase              # "planning" | "executing"
string  planner_state      # cuRobo feedback 'state', relayed while planning
float32 fraction_complete  # execution progress (0 while planning)
trajectory_msgs/JointTrajectoryPoint actual   # live measured q during execution
