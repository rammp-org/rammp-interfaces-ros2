# Goal — move through several 7-joint configurations in ONE motion. Each leg is
# planned as GoToJointConfig plans it (cuRobo plan_to_joints, collision-free), from
# where the leg before it ends, and the legs are blended into one trajectory, so the
# arm passes the configurations between still moving where blend_radius allows. The
# last configuration always stops. Every overlap is collision-checked, keeps the
# joint limits, and keeps the tool within blend_radius of where it is at that
# configuration; the planner (RAMMP-CuRobo's /rammp_curobo/blend) decides how far
# each corner is cut, and stops on the configuration where nothing can be.
#
# If any leg cannot be planned the goal ends PLANNING_FAILED before anything moves,
# and error_string names the leg ("leg 2/3: ...").
#
# Each target: positions only, 7 values, rad, joint_1..joint_7 (as
# GoToJointConfig's target_joints); every other field of the point must be empty.
trajectory_msgs/JointTrajectoryPoint[] targets   # at least one
string sender_id                      # arbitration hook, mirrors ExecuteJointTrajectory
uint8[16] token                       # arbitration capability from /acquire_control
# Per leg (the move TO targets[k]): GoToJointConfig's speed_scale. Empty: 1.0 for
# every leg; one value: that for every leg; otherwise one per target. Out of range
# is refused, as on GoToJointConfig. The trajectory carries the speeds, so a slow
# leg blends into a fast one.
float64[] speed_scale
# Per junction (between targets[k] and targets[k+1], so one fewer than targets), m:
# how far the tool may pass from where it is at targets[k] to cut the corner; 0
# stops on it. Empty: stop on every target.
float64[] blend_radius
# No orientation_hold here on purpose, as on GoToJointConfig.
# How the trajectory is EXECUTED, as on GoToJointConfig; one mode for the whole
# motion.
uint8 CONTROL_MODE_POSITION=0
uint8 CONTROL_MODE_IMPEDANCE=1
uint8 control_mode 0
ImpedanceGains gains
---
# Result
int32   error_code   # SUCCESSFUL=0, INVALID_GOAL=-1, PATH_TOLERANCE_VIOLATED=-4,
                     # PREEMPTED=-6, PLANNING_FAILED=-7,
                     # NOT_AUTHORIZED=-8, HALTED=-9
string  error_string
trajectory_msgs/JointTrajectoryPoint final_error   # joint-space final error
---
# Feedback
string  phase              # "planning" | "executing"
string  planner_state      # cuRobo feedback 'state', relayed while planning
float32 fraction_complete  # execution progress (0 while planning)
trajectory_msgs/JointTrajectoryPoint actual   # live measured q during execution
