# Goal — move through several 7-joint configurations in ONE motion. Each leg is
# planned as GoToJointConfig plans it (cuRobo plan_to_joints, collision-free), from
# where the leg before it ends, and the legs are blended into one trajectory
# (RAMMP-CuRobo's /rammp_curobo/blend), so the arm passes the configurations
# between still moving where each target's blend_radius allows. The last
# configuration always stops. Every overlap is collision-checked, keeps the joint
# limits, and brings the tool within each target's blend_radius of where it would
# be at that configuration.
#
# HOW A FAILURE ARRIVES.
#   - At submission, the goal is REJECTED (no result; the reason is in the
#     driver's log):
#       no targets; a joint value that is not finite; a speed_scale out of range;
#       a blend_radius that is negative or not finite; and otherwise as
#       GoToJointConfig (an unknown control_mode, or gains other than the default
#       on a POSITION goal).
#   - While planning, the goal is accepted and ends PLANNING_FAILED (-7) before
#     anything moves, error_string naming what failed: "leg k/N: <reason>" for
#     the plan of leg k (counted from 1: the move to targets[k-1]), or
#     "blend: <reason>" when the legs plan but cannot be joined.
#   - Otherwise, as the single-target action: a token that does not hold
#     control, and while executing PATH_TOLERANCE_VIOLATED, PREEMPTED, HALTED,
#     ... (the single-target actions currently report an unauthorized token as
#     INVALID_GOAL, not NOT_AUTHORIZED; these do the same).
#
# Result is the single-target action's. Feedback is too, except that while
# planning planner_state carries the same prefix: "leg 2/3: <cuRobo state>" or
# "blend: <state>".
JointConfigTarget[] targets   # at least one; each carries its own leg's fields
string sender_id              # arbitration hook, mirrors ExecuteJointTrajectory
uint8[16] token               # arbitration capability from /acquire_control
# How the trajectory is EXECUTED, as on GoToJointConfig; one mode for the whole
# motion.
uint8 CONTROL_MODE_POSITION=0
uint8 CONTROL_MODE_IMPEDANCE=1
uint8 control_mode 0
ImpedanceGains gains
---
# Result
int32   error_code   # SUCCESSFUL=0, INVALID_GOAL=-1, PATH_TOLERANCE_VIOLATED=-4,
                     # PREEMPTED=-6, PLANNING_FAILED=-7,
                     # NOT_AUTHORIZED=-8, HALTED=-9,
                     # CONTACT_STOP=-11
string  error_string
trajectory_msgs/JointTrajectoryPoint final_error   # joint-space final error
---
# Feedback
string  phase              # "planning" | "executing"
string  planner_state      # cuRobo's state while planning, prefixed "leg k/N: " or "blend: "
float32 fraction_complete  # execution progress (0 while planning)
trajectory_msgs/JointTrajectoryPoint actual   # live measured q during execution
