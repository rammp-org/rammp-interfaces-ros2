# Detect, then track every object found and publish them as ObjectDetections on the node's
# object_detections topic until StopTracking, or until the lease runs out on a server that enforces leases.
#
# One session at a time: a successful StartTracking ends any session already open.

string[] prompts
string   image_topic          # "" means the node's default_image_topic
float32  score_threshold      # 0 means the node's default
float64  lease_s              # > 0: the session ends lease_s after the last Start or Renew, where the server
                              # enforces leases (it refuses 0 then). Ignored by a server that does not.
float32  redetect_period_s    # re-run detection this often to pick up new objects; 0 = never
uint32   max_objects          # track at most this many, highest score first; 0 = the node's default
---
bool          accepted
uint32        session_id      # pass to RenewTracking and StopTracking
string        message
ObjectDetections detections   # the detection that seeded the session
